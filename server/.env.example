# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Chave de API da Asaas (Integrações > API Key, dentro da conta Asaas)
ASAAS_API_KEY=

# "sandbox" pra testar sem mexer com dinheiro real, "production" quando for pra valer
ASAAS_ENV=sandbox

# Token que a própria Asaas manda de volta em todo webhook, no header
# "asaas-access-token" — invente uma string aleatória longa e cadastre
# a MESMA string ao registrar o webhook (veja scripts/setup-webhook.js)
ASAAS_WEBHOOK_TOKEN=

# Domínio(s) que podem chamar esta API (separados por vírgula). Em branco,
# o servidor usa o domínio de produção do site como padrão (veja
# DEFAULT_ALLOWED_ORIGIN em index.js) — NUNCA use "*" combinado com
# credentials:true (o navegador manda o sendBeacon do tracking assim),
# isso deixaria qualquer site fazer requisição autenticada pra essa API.
ALLOWED_ORIGIN=

# Porta que o servidor escuta
PORT=7789

# Painel em /admin (status da Asaas, pedidos recentes, registrar webhook
# com um clique). Sem essas duas, o /admin fica desligado.
ADMIN_USER=
ADMIN_PASSWORD=

# Supabase (Project Settings > API) — onde ficam salvos os pedidos e os
# eventos do funil. Use a service_role key (secreta), NUNCA a anon key:
# as tabelas naipe_orders/naipe_funnel_events têm RLS sem nenhuma
# policy, então só a service_role consegue ler/escrever. Rode
# server/supabase-schema.sql uma vez no SQL Editor do projeto antes de
# usar. Sem essas duas, pedidos/eventos simplesmente não são salvos.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
