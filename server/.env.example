# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" nunca deve ser commitado (já está no .gitignore).

# Chave de API da Asaas (Integrações > API Key, dentro da conta Asaas)
ASAAS_API_KEY=

# "sandbox" pra testar sem mexer com dinheiro real, "production" quando for pra valer
ASAAS_ENV=sandbox

# Token que a própria Asaas manda de volta em todo webhook, no header
# "asaas-access-token" — invente uma string aleatória longa e cadastre
# a MESMA string ao registrar o webhook (veja scripts/setup-webhook.js)
ASAAS_WEBHOOK_TOKEN=

# Domínio(s) que podem chamar esta API (separados por vírgula). Use "*" só em teste local.
ALLOWED_ORIGIN=*

# Porta que o servidor escuta
PORT=7789
